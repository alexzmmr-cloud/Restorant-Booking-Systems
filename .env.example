# Локальная PostgreSQL. Замените значения на свои перед первым запуском.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/verde_marea?schema=public"

# Секрет для подписи серверной сессии. Локально — любая случайная строка (например: openssl rand -base64 32).
SESSION_SECRET="replace-with-random-string"
